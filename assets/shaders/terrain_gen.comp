#version 450 core
/**
 * @file terrain_gen.comp
 * @brief GPU procedural terrain heightfield (v2 TERRAN profile) — incremento 1 de la
 *        migración CPU→GPU. Porta EXACTAMENTE el Perlin de NoiseGenerator (perlin3D +
 *        fBm) para que la altura coincida con la CPU (paridad colisión↔visual), y
 *        replica la rama terran de sampleTerrainV2 (continentes + montañas ridged).
 *        Salida por vértice: elevación (km) + normal (diferencias finitas).
 *        LAGOS: salen del CAMPO (priority-flood en PlanetFields) desde F3, con el mismo nivel y la
 *        misma condición que sampleTerrainV2 → este es el camino de PRODUCCIÓN de la Tierra, no un
 *        experimento. (El comentario anterior decía "aún SIN lagos, opt-in y experimental": era de
 *        antes de F3 y llevaba tiempo siendo falso.)
 *
 * Entrada : dirs_in[i].xyz = dirección esférica unitaria del vértice i.
 * Salida  : elev_out[i]    = elevación en km.
 *           normal_out[i].xyz = normal de superficie (mundo, radial corregida).
 */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer DirsIn    { vec4  dirs_in[];   };
layout(std430, binding = 1) writeonly buffer ElevOut   { float elev_out[];  };
layout(std430, binding = 2) writeonly buffer NormalOut  { vec4 normal_out[]; };
layout(std430, binding = 3) writeonly buffer WaterOut   { float water_out[]; }; // nivel de agua km (0=mar, >0=lago)

// ===== F2: TECTÓNICA DE PLACAS — RETIRADA DEL SHADER ======================================
// Aquí vivían el SSBO de placas (binding 4) y los uniforms 20-25 (u_plateCount, u_geoContBaseKm,
// u_geoOceanBaseKm, u_geoBoundaryRad, u_geoMaxOrogenyKm, u_geoMarginRad), que alimentaban
// `geologyElevKm` — el port de PlanetGeology::sample. Desde F3 la orogenia viene HORNEADA en el
// campo (`sampleField4(...).w`) y esa función se quedó sin call-site: el enlazador eliminaba los
// seis uniforms, así que `gpu_heightfield.cpp` los subía a locations INACTIVAS en cada dispatch
// (GL_INVALID_OPERATION en drivers estrictos — el mismo caso que ya se documentó para las
// locations 2/5/6/7/8/9), y encima generaba y subía un SSBO de placas que nadie leía.
// Se han quitado los dos lados a la vez. Las locations 20-25 y el binding 4 quedan LIBRES.

// ===== PARÁMETROS EN UN UBO, no en uniforms sueltos por LOCATION ==========================
// Antes eran 16 `layout(location = N) uniform`. El problema no es el número: es que una location
// solo está ACTIVA si el enlazador ve que el uniforme se USA. Al morir `geologyElevKm` (ver la
// cabecera), sus seis uniforms dejaron de estar activos y el subidor siguió escribiendo en ellos —
// `GL_INVALID_OPERATION` en drivers estrictos, silencioso en los benévolos. Ese fallo SOLO es
// posible con locations sueltas: en un bloque, los campos existen porque el bloque existe, y si
// sobra uno se ve leyendo la struct, no esperando a que un driver se queje.
// Además es el paso 1 hacia el RHI: un UBO es `bindUniformBuffer` en cualquier backend, mientras que
// `glUniform1i(location, …)` no tiene equivalente en Vulkan.
// ⚠️ std140 con SOLO escalares int/float: cada uno ocupa y alinea a 4 bytes, así que el bloque es
// exactamente la struct de C++ empaquetada, en el mismo orden. NO meter aquí vec3/arrays sin releer
// las reglas de std140 (vec3 alinea a 16) — y si se añade un campo, va al FINAL y se actualiza el
// `static_assert` del tamaño en gpu_heightfield.cpp.
layout(std140, binding = 0) uniform TerrainGenParams {
    int   u_numVerts;
    int   u_seed;
    float u_reliefStrength;
    float u_invRadius;        // 1/planetRadius (para eps angular)
    float u_vertexSpacingM;   // separación entre vértices del chunk (m) → eps de la normal (LOD-aware)
    int   u_fieldRes;         // lado de cara del cube-sphere (0 = sin campo)
    int   u_mesoRes;          // lado de tesela (0 = sin meso)
    int   u_mesoLevel;        // teselas por lado de cara = 1<<level
    int   u_mesoHashSize;     // potencia de 2
    int   u_dbgTerm;          // 0 = normal (ver la nota de DEPURACIÓN DE PARIDAD abajo)
    int   u_deriveDirs;       // 0 = leer dirs_in (camino síncrono/paridad)
    int   u_gridRes;          // res: la rejilla es (res+1)²
    int   u_face;
    int   u_lod;
    int   u_chunkX;
    int   u_chunkY;
};

// ===== F3: CAMPOS EROSIONADOS (LA FUENTE DE VERDAD) =======================================
// La altura ya NO se re-deriva de una fórmula: se MUESTREA del campo que C++ generó y erosionó
// (PlanetFields). Es lo que permite tener valles tallados, cuencas y cauces — un terreno erosionado
// no es una función cerrada. GPU y CPU muestrean EL MISMO campo con EL MISMO bilineal → paridad.
layout(std430, binding = 5) readonly buffer FieldsIn { vec4 fieldCells[]; };  // x=elev(km) y=caudal z=lago(km)

// --- MESO: teselas erosionadas (~40 m/téxel). El macro (40 km/celda) tiene los valles pero NO los
// pisas; esto los baja a escala humana. Las teselas las genera y erosiona C++ (proceso iterativo:
// no es una fórmula) y se suben en un ATLAS. Si la tesela no está, se cae al macro.
layout(std430, binding = 6) readonly buffer MesoAtlas { float mesoCells[]; };   // slots × res²
// TABLA HASH de teselas: (face, tx, ty, slot+1). w==0 = hueco vacío. Sondeo lineal.
// Antes era una lista de slots barrida ENTERA por vértice (192 iteraciones × miles de vértices):
// eso ataba el cupo de teselas al coste del shader, y el cupo pequeño hacía que las teselas se
// evictaran bajo los pies del jugador (la malla se coció con tesela, la física ya no la tiene →
// alturas distintas → props flotando). Con hash, buscar es O(1) y el cupo se puede subir.
layout(std430, binding = 7) readonly buffer MesoTable { ivec4 mesoTable[]; };
// DEPURACIÓN DE PARIDAD: 0 = normal. >0 = devolver un TÉRMINO intermedio en vez de la elevación, para
// compararlo uno a uno con el mismo término del CPU (test `parity`). Existe porque las tres hipótesis
// que se probaron a ojo sobre el residuo CPU↔GPU fallaron: hay que medir por término, no suponer.
// 1=campo · 2=landMask · 3=hills · 4=midRelief · 5=montañas · 6=lecho marino · 7=suma sin recortes
// 8=mn (fBm de montaña) · 9=rmn (fBm de midRelief) · 10=form (perfil ridged) · 11=gate de altura.
// Los CRUDOS (8-11) son los que resolvieron el residuo: un término compuesto que discrepa no dice si
// el culpable es el ruido, la forma o el gate, y sin separarlos se vuelve a suponer.

// Locations 2, 5, 6, 7, 8 y 9 LIBRES: eran continentFreqA / seaThreshold / voronoiDensity /
// lakeDensity / lakeMaxProb / coastWidth. Todas alimentaban la rama LEGACY de sellos de lago y el
// distToCoast del ruido de continentalidad. Desde F3 la geografía sale del CAMPO, así que ni la
// altura ni el agua las miran. Se quitan TAMBIÉN del subidor (gpu_heightfield.cpp): un glUniform a
// una location sin uniforme activo depende de la benevolencia del driver.

// --- Direcciones DERIVADAS EN GPU (u_deriveDirs=1) ---------------------------------------
// Construir la rejilla de direcciones en CPU costaba ~25 ms por frame de ráfaga (16 chunks ×
// (res+1)² cubo→esfera) MÁS subirla. Es una función pura de (cara, lod, x, y, res): la GPU la
// calcula sola. En DOUBLE, igual que getLocalPosition en C++ — en float, el error de u,v a LOD
// alto desplaza el punto de muestreo ~1 m y la paridad CPU↔GPU se resiente.

// ===== RAÍCES EN DOUBLE REFINADAS A MANO — la causa raíz del residuo render↔colisión ==========
// MEDIDO en este equipo (Mesa 26.1 / ACO / Radeon renoir): el `sqrt` y el `inversesqrt` de DOUBLE del
// driver NO son correctamente redondeados, son ~1e-8 (precisión de float, no de double). Se comprobó
// escribiendo la normalización de cuatro formas distintas —`normalize(v)`, `v*(1/sqrt(d))`,
// `v.x/sqrt(d)` por componente, `v*inversesqrt(d)`— y las CUATRO dieron resultados IDÉNTICOS bit a
// bit: el compilador las colapsa todas en la misma `rsq` aproximada. No se puede arreglar
// reescribiendo la expresión.
//
// Por qué importa tanto: ese 1e-8 de la DIRECCIÓN se multiplica por la ESCALA del ruido al reducir la
// coordenada (`pos·scale`, hasta 96000 en midRelief) → error en el fBm, y de ahí en la altura. La
// firma que lo delató es que el error de cada fBm crecía en proporción a su frecuencia
// (300 → 800 → 6000). Medido en `haruka_tests parity`, término `rmn`: 2.6e-4 → **3.0e-8**, y el error
// de elevación total pasó de mediana 0.0007 / max 0.121 m a mediana 0.0000 / max 0.007 m.
//
// Newton sobre el RECÍPROCO usa solo *, − y +, que en double SÍ son IEEE en los dos lados, así que
// converge al mismo valor que la CPU. Dos pasos llevan 1e-8 → ~1e-16 (cuadrático). `precise` es
// OBLIGATORIO: sin él el compilador puede simplificar r·(1.5 − 0.5·d·r²) de vuelta a r.
double rsqrtExact(double d) {
    precise double r = 1.0LF / sqrt(d);                 // semilla del driver (~1e-8)
    r = r * (1.5LF - 0.5LF * d * (r * r));
    r = r * (1.5LF - 0.5LF * d * (r * r));
    return r;
}
// sqrt en double a precisión completa: d × el recíproco ya refinado. La usa el cubo→esfera de Cobb,
// que es el camino REAL de la malla (u_deriveDirs=1): con la sqrt del driver, la rejilla que hornea la
// GPU y la que evalúa la superficie de referencia en CPU caían en puntos separados ~1e-8.
// ⚠️ NO añadir un paso de Herón `s = 0.5·(s + d/s)` "para clavar el último bit": se probó y EMPEORA
// 50× (medido en `paridad`, nudo a nudo: 0.0001 m → 0.0053 m de media, y `midRelief` 2.7e-6 → 4.3e-3).
// La división de double también la resuelve el driver por un recíproco aproximado, así que ese paso
// vuelve a meter ~1e-8 en un valor que Newton ya había dejado en ~1e-16.
// REGLA que sale de aquí: en el camino que debe casar con la CPU, en double solo se pueden usar *, +
// y −. Cualquier división o raíz hay que obtenerla refinando con Newton a partir de la del driver.
double sqrtExact(double d) {
    if (!(d > 0.0LF)) return 0.0LF;
    precise double s = d * rsqrtExact(d);
    return s;
}

// Normalización en double, réplica de glm::normalize(dvec3): dot = (x·x + y·y) + z·z, luego v·(1/√dot).
dvec3 normalizeExact(dvec3 v) {
    precise double d = (v.x * v.x + v.y * v.y) + v.z * v.z;
    return v * rsqrtExact(d);
}

// Réplica EXACTA de TerrainGenerator::getLocalPosition (cubo→esfera de Cobb).
dvec3 gridDir(uint idx) {
    int stride = u_gridRes + 1;
    int x = int(idx) % stride;
    int y = int(idx) / stride;

    double numChunks = double(1 << u_lod);
    double u = (double(u_chunkX) + double(x) / double(u_gridRes)) / numChunks;
    double v = (double(u_chunkY) + double(y) / double(u_gridRes)) / numChunks;
    double lx = u * 2.0LF - 1.0LF;
    double ly = v * 2.0LF - 1.0LF;

    dvec3 p;
    if      (u_face == 0) p = dvec3( 1.0LF,  ly,   -lx);
    else if (u_face == 1) p = dvec3(-1.0LF,  ly,    lx);
    else if (u_face == 2) p = dvec3( lx,     1.0LF, -ly);
    else if (u_face == 3) p = dvec3( lx,    -1.0LF,  ly);
    else if (u_face == 4) p = dvec3( lx,     ly,    1.0LF);
    else                  p = dvec3(-lx,     ly,   -1.0LF);

    // ⚠️ sqrtExact, NO el sqrt del driver: en double es ~1e-8 (ver arriba), y esta es la rejilla que
    // la CPU replica en getLocalPosition/spherifyFace para la superficie de referencia.
    double x2 = p.x * p.x, y2 = p.y * p.y, z2 = p.z * p.z;
    return dvec3(p.x * sqrtExact(1.0LF - y2 / 2.0LF - z2 / 2.0LF + y2 * z2 / 3.0LF),
                 p.y * sqrtExact(1.0LF - z2 / 2.0LF - x2 / 2.0LF + z2 * x2 / 3.0LF),
                 p.z * sqrtExact(1.0LF - x2 / 2.0LF - y2 / 2.0LF + x2 * y2 / 3.0LF));
}

// ===================== Perlin 3D — PORT EXACTO de NoiseGenerator =====================
// hash/grad/fade idénticos al C++ (enteros 32-bit con wrap 2's-complement = GLSL int).
int nHash(int x, int y, int z, int seed) {
    int h = seed;
    h ^= 61 ^ x;
    h += (h << 3);
    h ^= (h >> 4);
    h += (h << 3) ^ y;
    h += (h << 3) ^ z;
    h ^= (h >> 4);
    h += (h << 3);
    return h & 0x7fffffff;
}
float nGrad(int hash, float x, float y, float z) {
    int h = hash & 15;
    float u = h < 8 ? x : y;
    float v = h < 8 ? y : z;
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}
float nFade(float t) { return t * t * (3.0 - 2.0 * t); }
float nLerp(float a, float b, float t) { return a + (b - a) * t; }

// ⚠️ `pos` en DOUBLE y `scale` en double: el producto y el floor se hacen en double y a float solo
// pasa la FRACCIÓN, que vive en [0,1). Hacerlo en float cuantizaba la posición (con scale 6000 el
// espaciado de float ya es ~1e-3 de celda) y CPU y GPU caían en celdas ligeramente distintas → sobre
// un planeta de 6371 km eso son centímetros de altura entre lo que se ve y lo que se pisa. El coste
// en double son 3 mul + 3 floor + 3 sub por octava; el resto del Perlin sigue en float.
// COPIA EXACTA de NoiseGenerator::perlin3D(dvec3) — si divergen, vuelven los "dos terrenos".
// ⚠️ PROBADO Y DESCARTADO (2026-07-26), para no repetirlo: la CPU evalúa el camino de altura con
// `perlin3D_d`, que usa la FORMA SEPARABLE (Σ V_ijk·wx·wy·wz) porque necesita el gradiente de la misma
// pasada; esto son LERPS ANIDADOS. Parecía una divergencia obvia, así que se portó la forma separable
// aquí y se midió: **NEUTRA** (`montanas` 0.1312 → 0.1311 m). El culpable era otro — el `sqrt` de
// double del driver, ver arriba. Se revirtió porque no aportaba precisión y el bucle indexado salía
// algo más caro (`stress`, terr_ms 0.28 → 0.33 ms; una sola pasada, dentro del ruido, pero sin ganancia
// que lo pague). Si algún día hay que unificarlas, que sea por mantenimiento y midiendo el coste.
float perlin3D(dvec3 pos, int seed, double scale) {
    dvec3 pd = pos * scale;
    double ffx = floor(pd.x), ffy = floor(pd.y), ffz = floor(pd.z);
    int x0 = int(ffx), y0 = int(ffy), z0 = int(ffz);
    float xf = float(pd.x - ffx), yf = float(pd.y - ffy), zf = float(pd.z - ffz);
    float u = nFade(xf), v = nFade(yf), w = nFade(zf);
    int xi = x0 & 255, yi = y0 & 255, zi = z0 & 255;
    int xj = (x0 + 1) & 255, yj = (y0 + 1) & 255, zj = (z0 + 1) & 255;
    float g000 = nGrad(nHash(xi, yi, zi, seed), xf,        yf,        zf);
    float g100 = nGrad(nHash(xj, yi, zi, seed), xf - 1.0,  yf,        zf);
    float g010 = nGrad(nHash(xi, yj, zi, seed), xf,        yf - 1.0,  zf);
    float g110 = nGrad(nHash(xj, yj, zi, seed), xf - 1.0,  yf - 1.0,  zf);
    float g001 = nGrad(nHash(xi, yi, zj, seed), xf,        yf,        zf - 1.0);
    float g101 = nGrad(nHash(xj, yi, zj, seed), xf - 1.0,  yf,        zf - 1.0);
    float g011 = nGrad(nHash(xi, yj, zj, seed), xf,        yf - 1.0,  zf - 1.0);
    float g111 = nGrad(nHash(xj, yj, zj, seed), xf - 1.0,  yf - 1.0,  zf - 1.0);
    float n00 = nLerp(g000, g100, u), n10 = nLerp(g010, g110, u);
    float n0  = nLerp(n00, n10, v);
    float n01 = nLerp(g001, g101, u), n11 = nLerp(g011, g111, u);
    float n1  = nLerp(n01, n11, v);
    return nLerp(n0, n1, w);
}
float fBm(dvec3 pos, int seed, int octaves, float persistence, float lacunarity, double scale) {
    if (octaves <= 0) return 0.0;
    precise float value = 0.0;
    float amplitude = 1.0, maxValue = 0.0;
    double frequency = 1.0LF;
    for (int i = 0; i < octaves; ++i) {
        value += perlin3D(pos, seed + i, scale * frequency) * amplitude;
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    return value / maxValue;
}

// (Aquí vivían `ssf` —smoothstep con e0>e1, se fue con la rama legacy de lagos— y el Perlin con
//  GRADIENTE ANALÍTICO `nGradD`/`perlin3D_d`/`fBmGrad`: la normal se calcula por DIFERENCIAS FINITAS
//  sobre 4 vecinos (ver main), así que el gradiente analítico nunca llegó a tener call-site.)

// (Aqui vivian distToCoastWorld + el Voronoi/hash de SELLOS DE LAGO. Se borraron con la rama
//  legacy de lagos: los lagos salen del CAMPO desde F3 y nadie mas los usaba.)

const float A_NORM = 0.45;

// (Aquí vivía el ruido de valor 3D portado de planet_geology.cpp —`gHashU`/`gHashC`/`gH01`/`gVHash`/
//  `gVNoise`/`gWarp`—. Solo lo usaba `geologyElevKm`, que se fue con la tectónica: ver la cabecera.)

// --- Cube-sphere: dirección -> (cara,u,v). PORT EXACTO de planet_fields.cpp -------------------
// En DOUBLE: la división en double es IEEE-exacta en CPU y GPU, así que u/v salen bit a bit iguales.
// En float, cada lado redondeaba a su manera ANTES de escalar por faceRes (256), y ese redondeo se
// convertía en error del peso bilineal (ver sampleField4).
void dirToFaceUVd(dvec3 d, out int face, out double u, out double v) {
    double ax = abs(d.x), ay = abs(d.y), az = abs(d.z);
    if (ax >= ay && ax >= az) {
        if (d.x > 0.0) { face = 0; u = -d.z / ax; v = -d.y / ax; }
        else           { face = 1; u =  d.z / ax; v = -d.y / ax; }
    } else if (ay >= az) {
        if (d.y > 0.0) { face = 2; u =  d.x / ay; v =  d.z / ay; }
        else           { face = 3; u =  d.x / ay; v = -d.z / ay; }
    } else {
        if (d.z > 0.0) { face = 4; u =  d.x / az; v = -d.y / az; }
        else           { face = 5; u = -d.x / az; v = -d.y / az; }
    }
}
// (La versión en FLOAT de dirToFaceUV se ha borrado: todo el camino usa la de double, que es lo que
//  hace que el peso bilineal salga bit a bit igual que en la CPU.)

// Muestreo BILINEAL del campo. Debe ser idéntico bit-a-bit al de PlanetFields::sample o la malla
// (GPU) y la colisión (CPU) discreparían.
vec4 sampleField4(dvec3 d) {   // -> (elev km, caudal, lago km, orogenia)
    if (u_fieldRes <= 0) return vec4(0.0);
    // ⚠️ `d` DEBE llegar ya normalizado. Antes se re-normalizaba aquí, y ESO era el error de paridad:
    // `normalize` de GLSL usa `inversesqrt` (hardware) y el de glm usa `1/sqrt` → re-normalizar un
    // vector que YA es unitario lo mueve ~1 ulp, distinto en cada lado. Un ulp de float en `dir` son
    // ~0.38 m sobre la superficie de la Tierra (6371 km × 6e-8) y, multiplicado por la pendiente, se
    // convierte en los ~4 cm de discrepancia render↔colisión. Medido: la sensibilidad del CPU a 1 ulp
    // (mediana 0.0396 m) es LA MISMA distribución que el error CPU↔GPU (0.0424 m).
    int f; double u, v;
    dirToFaceUVd(d, f, u, v);
    int R = u_fieldRes;
    // fx/fy en DOUBLE (antes float + `precise` para evitar el FMA). El `precise` tapaba el síntoma
    // pero no la causa: `fx` llega a 255 y de él solo se usa la FRACCIÓN, así que 1 ulp de float a esa
    // magnitud (1.5e-5) es 1.5e-5 de peso bilineal sobre una celda de ~39 km = centímetros de altura.
    // En double el ulp es 3e-14 y la fracción sale exacta. Coste: unas pocas ops fp64 por vértice,
    // frente a los ~20 fBm que ya se evalúan. ⚠️ MISMA expresión en PlanetFields::sample.
    double fx = clamp((u * 0.5LF + 0.5LF) * double(R) - 0.5LF, 0.0LF, double(R) - 1.001LF);
    double fy = clamp((v * 0.5LF + 0.5LF) * double(R) - 0.5LF, 0.0LF, double(R) - 1.001LF);
    int i0 = int(fx), j0 = int(fy);
    int i1 = min(i0 + 1, R - 1), j1 = min(j0 + 1, R - 1);
    // Pesos e interpolación en DOUBLE: los valores del campo son float32, así que cada producto cabe
    // EXACTO en double y las sumas son IEEE en los dos lados → la bilineal sale bit a bit igual. En
    // float dependía de si el compilador fundía `a*(1-t) + b*t` en un FMA, y CPU y GPU decidían
    // distinto; el `precise` que había aquí intentaba evitarlo y no bastaba.
    double tx = fx - double(i0), ty = fy - double(j0);
    int base = f * R * R;
    vec4 c00 = fieldCells[base + j0 * R + i0];
    vec4 c10 = fieldCells[base + j0 * R + i1];
    vec4 c01 = fieldCells[base + j1 * R + i0];
    vec4 c11 = fieldCells[base + j1 * R + i1];
    // ESCRITA IGUAL que la de PlanetFields::sample (`a*(1-t) + b*t`). Aquí un ulp del campo se
    // amplifica: `midRelief` va gateado por un smoothstep de pendiente 12.5/km, así que un error de
    // milímetros en el campo sale multiplicado en la altura final.
    dvec4 e0 = dvec4(c00) * (1.0LF - tx) + dvec4(c10) * tx;
    dvec4 e1 = dvec4(c01) * (1.0LF - tx) + dvec4(c11) * tx;
    return vec4(e0 * (1.0LF - ty) + e1 * ty);
}

// Altura del MESO. PORT EXACTO de PlanetMeso::elevKm (misma tesela, mismo bilineal → paridad).
// Devuelve false si la tesela no está residente (→ el llamador usa el macro).
bool sampleMeso(dvec3 d, out float outElev) {   // `d` ya normalizado (ver sampleField4)
    outElev = 0.0;
    if (u_mesoRes <= 0 || u_mesoHashSize <= 0) return false;
    // Coordenada de celda en DOUBLE, igual que PlanetMeso::elevKmIfResident. Aquí importa aún más que
    // en el campo: `gx` llega a TILES·R (miles), y en float el ulp a esa magnitud es una fracción
    // apreciable de téxel — o sea, la malla y la colisión interpolarían téxeles distintos.
    int f; double u, v;
    dirToFaceUVd(d, f, u, v);
    int TILES = 1 << u_mesoLevel;
    int R = u_mesoRes;
    double gx = (u * 0.5LF + 0.5LF) * double(TILES) * double(R);
    double gy = (v * 0.5LF + 0.5LF) * double(TILES) * double(R);
    int tx = clamp(int(gx / double(R)), 0, TILES - 1);
    int ty = clamp(int(gy / double(R)), 0, TILES - 1);

    // Hash de (face,tx,ty) + sondeo lineal. Mismo hash que la CPU (planet_meso.cpp) o buscaría mal.
    uint h = uint(f) * 73856093u ^ uint(tx) * 19349663u ^ uint(ty) * 83492791u;
    h ^= h >> 15; h *= 0x2c1b3c6du; h ^= h >> 12;
    int mask = u_mesoHashSize - 1;
    int idx  = int(h) & mask;
    int slot = -1;
    for (int probe = 0; probe < 32; ++probe) {
        ivec4 t = mesoTable[idx];
        if (t.w == 0) return false;                                  // hueco vacío → no está
        if (t.x == f && t.y == tx && t.z == ty) { slot = t.w - 1; break; }
        idx = (idx + 1) & mask;
    }
    if (slot < 0) return false;

    int base = slot * R * R;
    double fx = clamp(gx - double(tx * R) - 0.5LF, 0.0LF, double(R) - 1.001LF);
    double fy = clamp(gy - double(ty * R) - 0.5LF, 0.0LF, double(R) - 1.001LF);
    int i0 = int(fx), j0 = int(fy);
    int i1 = min(i0 + 1, R - 1), j1 = min(j0 + 1, R - 1);
    float sx = float(fx - double(i0)), sy = float(fy - double(j0));
    float e0 = mix(mesoCells[base + j0 * R + i0], mesoCells[base + j0 * R + i1], sx);
    float e1 = mix(mesoCells[base + j1 * R + i0], mesoCells[base + j1 * R + i1], sx);
    outElev = mix(e0, e1, sy);
    return true;
}

// (Aquí vivía `geologyElevKm`, el port de PlanetGeology::sample: 60 líneas que recorrían las 30
//  placas por vértice para re-derivar la elevación base y la orogenia. Desde F3 las dos salen del
//  CAMPO —`sampleField4(...).x` y `.w`—, que además viene ya erosionado, así que la función quedó
//  sin call-site. Con ella se van sus uniforms y su SSBO: ver la cabecera del fichero.)

// Rama TERRAN de sampleTerrainV2: continentes + montañas ridged + LAGOS (talla la
// cuenca y fija el nivel de agua). km. outWaterKm = nivel de agua aplicable (0=mar,
// >0=lago dentro de un sello activo), idéntico a sampleTerrainV2.
// RAMPA DE AMPLITUD DEL MESO por espaciado de vértices (m). Llega a 0 en 180 m, por debajo del gate
// de 200 m con el que se piden teselas → el chunk más grueso que aún lleva meso tiene amplitud ~0 y
// por tanto COINCIDE con su padre, que no lleva meso. Ahí muere el escalón.
// ⚠️ COPIA EXACTA en terrain_generator.cpp::mesoRampCPU (paridad CPU↔GPU).
float mesoRamp(float spacingM) { return 1.0 - smoothstep(60.0, 180.0, spacingM); }

// Salida lateral de terranElevKm: cuánto restar (km) para obtener la superficie del LOD PADRE.
// Se lee INMEDIATAMENTE después de la llamada principal en main(), antes de que las llamadas de la
// normal (4 vecinos) lo sobrescriban.
float g_mesoMorphDeltaKm = 0.0;

// `dirD` en DOBLE de principio a fin: va al RUIDO y también al CAMPO, igual que hace la CPU en
// sampleTerrainV2 → misma partición, mismos valores. (Antes se sacaba aquí una copia en float
// `dir` para la geología; con la geología fuera, ya no la mira nadie.)
float terranElevKm(dvec3 dirD, out float outWaterKm) {
    int seed = u_seed;

    // ===== F2 — la elevación BASE la da la TECTÓNICA, no un fBm =====
    // PORT EXACTO de terrain_sampler_v2.cpp → la malla (GPU) y la física (CPU) coinciden.
    // (F3) TODO sale del CAMPO: altura erosionada, caudal, agua y OROGENIA (horneada de la
    // tectónica). Antes aquí se evaluaban las 30 placas + 6 ruidos de warp POR VÉRTICE — el grueso
    // del coste de reconstruir terreno, y para nada: la altura ya no sale de esa fórmula.
    // ⚠️ El campo se muestrea con la dirección en DOUBLE (`dirD`), no con la redondeada a float:
    // es lo que hace que CPU y GPU caigan en el MISMO punto de la retícula del campo.
    vec4  fld     = sampleField4(dirD);
    float geoBase = fld.x;
    float oro     = fld.w;               // orogenia con signo (>0 = el límite levanta montaña)
    // El MESO trae detalle + erosión local a escala humana. Se SUMA como delta ACOTADO al macro (no lo
    // REEMPLAZA): el delta se acota a ±45 m (≤ faldón de 50 m en el gate de 200 m, ver
    // terrain_generator.cpp::skirtDepth) para que el escalón meso(fino)↔macro(grueso) quede OCULTO por
    // la falda → sin muros. SIN rampa por LOD: eso desplazaba la malla respecto a la colisión (terreno
    // ~1-2 m por encima del suelo real). Así es IDÉNTICO a terrain_sampler_v2.cpp → malla == colisión.
    // GEOMORPH DEL MESO (2026-07-25). El problema que resuelve: el meso solo se pedía con
    // vertexSpacing < 200 m, así que el chunk FINO lo llevaba y su PADRE no → dos superficies
    // distintas separadas por el clamp (45 m). Como la colisión lee la malla DIBUJADA, al cambiar el
    // LOD bajo los pies el suelo SALTABA (medido: 132 m al girar, con el jugador cayendo y los props
    // quedándose arriba = "dos terrenos").
    // Arreglo en dos partes:
    //  (1) la amplitud se RAMPA con el espaciado y llega a 0 justo donde el meso deja de pedirse →
    //      el chunk más grueso con meso y su padre SIN meso ya coinciden: no hay escalón en el gate.
    //  (2) se exporta cuánto habría que RESTAR para obtener la superficie del PADRE, y el morph CDLOD
    //      interpola también esa AMPLITUD (no solo la geometría) → la transición entre niveles es
    //      CONTINUA. Sin (2) la rampa solo mueve el escalón de sitio, no lo elimina.
    // ⚠️ La rampa debe ser IDÉNTICA en terrain_generator.cpp (camino CPU) o se rompe la paridad.
    float mesoMorphDeltaKm = 0.0;      // km a restar para llegar a la superficie del LOD padre
    float mesoE;
    if (sampleMeso(dirD, mesoE)) {
        float d  = clamp(mesoE - geoBase, -0.045, 0.045);   // delta acotado al faldón (50 m)
        float w  = mesoRamp(u_vertexSpacingM);              // amplitud de ESTE chunk
        float wp = mesoRamp(u_vertexSpacingM * 2.0);        // la de su PADRE (espaciado doble)
        geoBase += w * d;
        mesoMorphDeltaKm = (w - wp) * d;
    }
    g_mesoMorphDeltaKm = mesoMorphDeltaKm;

    // Tierra/mar: el nivel del mar es elev = 0. BANDA ESTRECHA (±2 m): con una banda ancha, todo
    // el terreno entre 0 y 60 m caía en landMask<0.5 y el clamp de costa lo HUNDÍA → llanura costera
    // sumergida. (Idéntico a terrain_sampler_v2.cpp → paridad.)
    float landMask = smoothstep(-0.002, 0.002, geoBase);

    // ===== Detalle CONDICIONADO por los campos (ya no es ruido libre) =====
    // --- CAUCE (nivel C): el CAUDAL del campo TALLA el terreno (idéntico a la CPU → paridad) ---
    // El campo sabe por dónde va el río; aquí ese caudal se convierte en GEOMETRÍA: encaja el cauce
    // y aplana la vega. Es lo que hace que el río se VEA al caminar.
    float flow    = fld.y;
    float valleyW = smoothstep(0.18, 0.50, flow);            // fondo de valle (más ancho)
    // (Aquí se calculaban `riverW` —cauce principal— y de él `carveKm = riverW * 0.045`, que NUNCA se
    //  restaba: el cauce ya lo talla la erosión del meso —ver abajo— y volver a encajarlo aquí lo
    //  duplicaría. Los dos eran trabajo muerto por vértice. Borrados también en la CPU.)

    float hmn        = fBm(dirD, seed + 77, 5, 0.5, 2.0, 300.0);
    float hills      = hmn * (1.0 / A_NORM);
    // (El MESO ya trae el detalle fino Y erosionado → las colinas quedan como variación de gran
    //  escala, muy bajas; si no, se sumarían al relieve que la erosión ya esculpió.) Idéntico a CPU.
    float hillRelief = hills * landMask * (0.12 * (1.0 - 0.85 * valleyW));

    // Rodadura de MEDIA FRECUENCIA (~6.7 km de onda, 5 octavas): relieve de cerca LOD-CONTINUO (sin muros
    // ni offset) gateado por hidrología. IDÉNTICO a terrain_sampler_v2.cpp (paridad malla↔física).
    float rmn        = fBm(dirD, seed + 201, 5, 0.5, 2.0, 6000.0);
    // ⚠️ ENTRA CON LA ALTURA (0 al nivel del mar → pleno a ~120 m): a plena amplitud en la costa hundía
    // franjas de tierra bajo el mar, pero el agua solo se dibuja donde el CAMPO dice océano (water.frag)
    // → tierra seca en un hoyo bajo la línea de agua. El fade (≥ amplitud) mantiene la costa sobre el mar.
    float midRelief  = rmn * (1.0 / A_NORM) * landMask * (0.10 * (1.0 - 0.6 * valleyW))
                     * smoothstep(0.0, 0.12, geoBase);

    // Crestas RIDGED: SOLO donde la tectónica levanta montaña (orogenia × convergencia) → las
    // crestas SIGUEN la cordillera en vez de salpicar toda la tierra.
    float mn     = fBm(dirD, seed + 123, 5, 0.5, 2.1, 800.0);
    float na     = mn * (1.0 / A_NORM);
    // x^1.25 = x·√√x (EXACTO: solo raíces, que son IEEE en CPU y GPU). Con `pow` fraccionario la
    // GPU (exp2/log2) y `std::pow` diferían ~1e-5 relativo = ~1.5 cm sobre el término de montaña.
    float fx     = clamp(1.0 - abs(na), 0.0, 1.0);
    float form   = fx * sqrt(sqrt(fx));
    float mtnAmp = oro * u_reliefStrength;   // la orogenia ya viene con el signo aplicado
    float mountains = form * (1.4 * mtnAmp);

    // Relieve del lecho oceánico (montes submarinos), solo mar adentro.
    float omn   = fBm(dirD, seed + 311, 5, 0.5, 2.1, 600.0);
    float ona   = omn * (1.0 / A_NORM);
    float ofx   = clamp(1.0 - abs(ona), 0.0, 1.0);
    float oform = ofx * sqrt(ofx);                       // x^1.5 EXACTO
    float seaRelief = (oform - 0.5) * ((1.0 - landMask) * 0.6);

    // El CAUCE ya lo talla la erosión del meso → no se vuelve a restar aquí (se duplicaría).
    float elev = geoBase + hillRelief + midRelief + mountains + seaRelief;

    // Salida de DEPURACIÓN por término (ver u_dbgTerm). Va aquí, antes de los recortes de costa y de
    // los lagos, porque lo que se quiere aislar es de dónde sale el residuo de paridad.
    if (u_dbgTerm != 0) {
        outWaterKm = 0.0;
        if (u_dbgTerm == 1) return geoBase;
        if (u_dbgTerm == 2) return landMask;
        if (u_dbgTerm == 3) return hillRelief;
        if (u_dbgTerm == 4) return midRelief;
        if (u_dbgTerm == 5) return mountains;
        if (u_dbgTerm == 6) return seaRelief;
        if (u_dbgTerm == 7) return elev;
        // ENTRADAS CRUDAS (adimensionales). Un término compuesto que discrepa no dice si el culpable
        // es el RUIDO, la FORMA ridged o el GATE de altura: hay que separarlos o se vuelve a suponer.
        if (u_dbgTerm == 8)  return mn;
        if (u_dbgTerm == 9)  return rmn;
        if (u_dbgTerm == 10) return form;
        return smoothstep(0.0, 0.12, geoBase);
    }

    // Costa estable entre LODs (clamp de ambos lados, IDÉNTICO a la CPU).
    elev = (landMask > 0.5) ? max(elev, 0.005) : min(elev, -0.005);

    // --- LAGOS: los pone el CAMPO (priority-flood), no un hash ---------------------------------
    // ⚠️ Aquí vivía la rama LEGACY de "sellos de lago" (voronoi + hash) de antes de F3, que la CPU
    // (sampleTerrainV2) ya no tiene. Hacía DOS destrozos, los dos medidos:
    //  1. TALLABA la cuenca (`elev -= ssf(...)·Dkm`, hasta 60 m) solo en la MALLA → la colisión no
    //     tenía ese hoyo. Es el outlier de `haruka_tests parity`: 37.565 m en tierra con el campo
    //     diciendo agua=0.000 (la suma sin recortes tiene 0.12 m de pico: no venía de los términos).
    //  2. Peor: fijaba el nivel `outWaterKm = regionalElevKm(centro)` — una función del RUIDO DE
    //     CONTINENTALIDAD, sin relación con la altura real de aquí — hasta 1.0 km, y para TODA la
    //     celda del hash (densidad 120 ⇒ ~53 km de lado), no solo dentro del radio del lago. Con el
    //     terreno a 0.4 km eso emite una lámina de agua PLANA 600 m POR ENCIMA del suelo, de decenas
    //     de km: el terreno desaparece bajo el agua. Y solo se dibuja en chunks finos (los lagos se
    //     emiten con vtxSpacing bajo) → aparece y desaparece al refinar = "a veces".
    // Ahora el nivel sale del MISMO campo que usa la CPU (fld.z = cota de la cuenca endorreica), con
    // la MISMA condición que sampleTerrainV2 (`waterKm > 0 && waterKm > elev`) → paridad exacta.
    outWaterKm = (fld.z > 0.0 && fld.z > elev) ? fld.z : 0.0;   // 0 = mar · >0 = lago
    return elev;
}

// Wrapper sin el nivel de agua (para las normales por vecinos).
float terranElevKm(dvec3 dirD) { float w; return terranElevKm(dirD, w); }

// Elevación km → fracción del radio (e km = e*1000 m; fracción = e*1000/R).
float frac(float km) { return km * 1000.0 * u_invRadius; }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(u_numVerts)) return;

    // NORMALIZACIÓN EN DOUBLE, y una sola vez. `sqrt` en double es exacto por IEEE en CPU y GPU, así
    // que el vector unitario redondeado a float sale BIT A BIT IGUAL en los dos lados — que es la
    // condición para que la malla y la colisión evalúen la fórmula en EL MISMO punto. Con el
    // `normalize` float de aquí, los dos lados caían en puntos separados 1 ulp (~0.38 m de superficie)
    // y el terreno lo amplificaba a ~4 cm de altura.
    dvec3 dirD = (u_deriveDirs != 0) ? normalizeExact(gridDir(idx))
                                     : normalizeExact(dvec3(dirs_in[idx].xyz));
    vec3  dir  = vec3(dirD);
    float waterKm;
    elev_out[idx]  = terranElevKm(dirD, waterKm);
    water_out[idx] = waterKm;
    // Capturado AQUÍ: las 4 llamadas de la normal (abajo) vuelven a escribir el global.
    float mesoMorphDeltaKm = g_mesoMorphDeltaKm;

    // Normal GEOMÉTRICA: posiciones desplazadas de 4 vecinos y producto vectorial de las tangentes.
    // FASE 4 — eps = ESPACIADO DE VÉRTICES del chunk (LOD-aware), no un ~2 m fijo: así la normal
    // representa la geometría a ESTA resolución y NO capta ruido sub-vértice → mata los PINCHOS de
    // shading (la normal fina no casaba con los triángulos grandes). El relieve < espaciado lo pone
    // applyDetailNormal per-píxel. Suelo de 2 m para no degenerar en chunks finísimos.
    vec3 ref = (abs(dir.y) < 0.99) ? vec3(0,1,0) : vec3(1,0,0);
    vec3 T = normalize(cross(ref, dir));
    vec3 B = cross(dir, T);
    float eps = max(max(u_vertexSpacingM, 2.0) * u_invRadius, 1e-7);
    vec3 dTp = normalize(dir + T * eps), dTm = normalize(dir - T * eps);
    vec3 dBp = normalize(dir + B * eps), dBm = normalize(dir - B * eps);
    vec3 pTp = dTp * (1.0 + frac(terranElevKm(dTp)));
    vec3 pTm = dTm * (1.0 + frac(terranElevKm(dTm)));
    vec3 pBp = dBp * (1.0 + frac(terranElevKm(dBp)));
    vec3 pBm = dBm * (1.0 + frac(terranElevKm(dBm)));
    vec3 nrm = normalize(cross(pTp - pTm, pBp - pBm));
    if (dot(nrm, dir) < 0.0) nrm = -nrm;
    // .w viaja el delta del geomorph del meso (km). Este canal estaba a 0.0 y la CPU lo descartaba
    // (`glm::vec3(norm4[i])`), así que no hace falta un cuarto buffer de readback — que es el pool
    // frágil donde soltar un slot dos veces congela el streaming.
    normal_out[idx] = vec4(nrm, mesoMorphDeltaKm);
}
